@page "/books"
@inject HttpClient Http
@inject BookStore.Ui.Services.ICartService CartService

<div class="bg-light py-5 mb-5">
    <div class="container text-center">
        <h1 class="display-4 fw-bold">Book Gallery</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Gallery</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-lg-3 mb-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">Categories</h5>
                    <div class="list-group list-group-flush">
                        <button class="list-group-item list-group-item-action border-0 px-0 d-flex justify-content-between align-items-center @(SelectedCategory == null ? "text-primary fw-bold" : "text-muted")" @onclick="() => SelectCategory(null)">
                            All Books
                            <i class="bi bi-chevron-right small"></i>
                        </button>
                        @if (categories != null)
                        {
                            @foreach (var cat in categories)
                            {
                                <button class="list-group-item list-group-item-action border-0 px-0 d-flex justify-content-between align-items-center @(SelectedCategory == cat.Name ? "text-primary fw-bold" : "text-muted")" @onclick="() => SelectCategory(cat.Name)">
                                    @cat.Name
                                    <i class="bi bi-chevron-right small"></i>
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">Filter by Tags</h5>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-light text-dark border p-2">Biography</span>
                        <span class="badge bg-light text-dark border p-2">Business</span>
                        <span class="badge bg-light text-dark border p-2">Cookbooks</span>
                        <span class="badge bg-light text-dark border p-2">History</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <p class="mb-0 text-muted">Showing @(books?.Count ?? 0) results</p>
                <div class="d-flex align-items-center">
                    <span class="me-2 text-muted small">Sort By:</span>
                    <select class="form-select form-select-sm border-0 shadow-sm" style="width: auto;">
                        <option>Default sorting</option>
                        <option>Price: Low to High</option>
                        <option>Price: High to Low</option>
                    </select>
                </div>
            </div>

            @if (books == null)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-3 g-4 mb-5">
                    @foreach (var book in books)
                    {
                        <div class="col">
                            <div class="card h-100 border-0 shadow-sm transition-hover">
                                <img src="@book.ImgUrl" class="card-img-top" alt="@book.Name" style="height: 250px; object-fit: cover;">
                                <div class="card-body text-center">
                                    <h6 class="fw-bold mb-1">@book.Name</h6>
                                    <div class="text-primary fw-bold mb-3">$@book.Price</div>
                                    <div class="d-flex justify-content-center gap-2">
                                        <button class="btn btn-outline-primary btn-sm rounded-circle" title="Add to Cart" @onclick="() => AddToCart(book.Id)">
                                            <i class="bi bi-cart-plus"></i>
                                        </button>
                                        <a href="/details/@book.Id" class="btn btn-primary btn-sm rounded-pill px-3">Details</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination Placeholder -->
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        <li class="page-item disabled"><a class="page-link border-0 shadow-sm mx-1 rounded" href="#">1</a></li>
                        <li class="page-item"><a class="page-link border-0 shadow-sm mx-1 rounded" href="#">2</a></li>
                        <li class="page-item"><a class="page-link border-0 shadow-sm mx-1 rounded" href="#">3</a></li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<style>
    .transition-hover {
        transition: transform 0.2s ease-in-out;
    }
    .transition-hover:hover {
        transform: scale(1.03);
    }
</style>

@code {
    private List<BookDto> books;
    private List<CategoryDto> categories;
    private string SelectedCategory;

    protected override async Task OnInitializedAsync()
    {
        categories = await Http.GetFromJsonAsync<List<CategoryDto>>("api/categories");
        await LoadBooks();
    }

    private async Task LoadBooks()
    {
        var url = "api/books";
        if (!string.IsNullOrEmpty(SelectedCategory))
        {
            url += $"?category={Uri.EscapeDataString(SelectedCategory)}";
        }
        books = await Http.GetFromJsonAsync<List<BookDto>>(url);
    }

    private async Task SelectCategory(string category)
    {
        SelectedCategory = category;
        await LoadBooks();
    }

    private async Task AddToCart(int bookId)
    {
        var cartId = await CartService.GetCartId();
        await Http.PostAsync($"api/shoppingcart/{cartId}/add/{bookId}", null);
    }
}
