@page "/checkout"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject BookStore.Ui.Services.ICartService CartService

<div class="container mt-4">
    <h2>Checkout</h2>
    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-4">Shipping Information</h5>
                    <EditForm Model="order" OnValidSubmit="HandleCheckout">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="form-label">First Name</label>
                                <InputText @bind-Value="order.FirstName" class="form-control" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label">Last Name</label>
                                <InputText @bind-Value="order.LastName" class="form-control" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Address</label>
                                <InputText @bind-Value="order.Address" class="form-control" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Email</label>
                                <InputText @bind-Value="order.Email" class="form-control" />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">City/State</label>
                                <InputText @bind-Value="order.State" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Zip</label>
                                <InputText @bind-Value="order.ZipCode" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Phone</label>
                                <InputText @bind-Value="order.PhoneNumber" class="form-control" />
                            </div>
                        </div>

                        <hr class="my-4">
                        <button class="w-100 btn btn-primary btn-lg" type="submit">Place Order</button>
                    </EditForm>
                </div>
            </div>
        </div>
        <div class="col-md-4">
             @if (cart != null)
             {
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title mb-4">Order Summary</h5>
                        <ul class="list-group list-group-flush mb-3">
                            @foreach (var item in cart.Items)
                            {
                                <li class="list-group-item d-flex justify-content-between lh-sm">
                                    <div>
                                        <h6 class="my-0">@item.BookName</h6>
                                        <small class="text-muted">Qty: @item.Amount</small>
                                    </div>
                                    <span class="text-muted">$@(item.Price * item.Amount)</span>
                                </li>
                            }
                            <li class="list-group-item d-flex justify-content-between">
                                <span>Total (USD)</span>
                                <strong>$@cart.Total</strong>
                            </li>
                        </ul>
                    </div>
                </div>
             }
        </div>
    </div>
</div>

@code {
    private OrderDto order = new OrderDto();
    private ShoppingCartDto cart;
    private string cartId;

    protected override async Task OnInitializedAsync()
    {
        cartId = await CartService.GetCartId();
        cart = await Http.GetFromJsonAsync<ShoppingCartDto>($"api/shoppingcart/{cartId}");
    }

    private async Task HandleCheckout()
    {
        var response = await Http.PostAsJsonAsync($"api/orders/checkout/{cartId}", order);
        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/order-success");
        }
    }
}
