@page "/"
@inject HttpClient Http
@inject BookStore.Ui.Services.ICartService CartService

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-4">Welcome to Our BookStore</h1>
            <p class="lead">Discover your next favorite book today.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-3">
            <div class="list-group mb-4">
                <button class="list-group-item list-group-item-action @(SelectedCategory == null ? "active" : "")" @onclick="() => SelectCategory(null)">
                    All Categories
                </button>
                @if (categories != null)
                {
                    @foreach (var category in categories)
                    {
                        <button class="list-group-item list-group-item-action @(SelectedCategory == category.Name ? "active" : "")" @onclick="() => SelectCategory(category.Name)">
                            @category.Name
                        </button>
                    }
                }
            </div>
        </div>
        <div class="col-md-9">
            @if (books == null)
            {
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-3 g-4">
                    @foreach (var book in books)
                    {
                        <div class="col">
                            <div class="card h-100 shadow-sm">
                                <img src="@book.ImgUrl" class="card-img-top" alt="@book.Name" style="height: 200px; object-fit: cover;">
                                <div class="card-body">
                                    <h5 class="card-title">@book.Name</h5>
                                    <p class="card-text text-muted small">by @book.Author</p>
                                    <h6 class="text-primary">$@book.Price</h6>
                                </div>
                                <div class="card-footer bg-transparent border-top-0">
                                    <div class="d-grid gap-2">
                                        <a href="/details/@book.Id" class="btn btn-outline-secondary">Details</a>
                                        <button class="btn btn-primary" @onclick="() => AddToCart(book.Id)">Add to Cart</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<BookDto> books;
    private List<CategoryDto> categories;
    private string SelectedCategory;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        categories = await Http.GetFromJsonAsync<List<CategoryDto>>("api/categories");
        await LoadBooks();
    }

    private async Task LoadBooks()
    {
        var url = "api/books";
        if (!string.IsNullOrEmpty(SelectedCategory))
        {
            url += $"?category={Uri.EscapeDataString(SelectedCategory)}";
        }
        books = await Http.GetFromJsonAsync<List<BookDto>>(url);
    }

    private async Task SelectCategory(string category)
    {
        SelectedCategory = category;
        await LoadBooks();
    }

    private async Task AddToCart(int bookId)
    {
        var cartId = await CartService.GetCartId();
        await Http.PostAsync($"api/shoppingcart/{cartId}/add/{bookId}", null);
        // Show notification or update cart count
    }
}
